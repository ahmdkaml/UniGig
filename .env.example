# ==============================================================================
# UniGig Local & Container Environment Variables Template
# Copy this file to .env and replace dummy values with your local/staging secrets
# ==============================================================================

# --- PostgreSQL Container Settings ---
POSTGRES_DB=unigig
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_PORT=5432

# --- Backend Server & Profile ---
PORT=8080
# Use "default" for PostgreSQL or "slim" for embedded H2 in PostgreSQL mode
SPRING_PROFILES_ACTIVE=default

# --- Backend Datasource ---
# When running backend inside Docker Compose, host is "postgres"; from host CLI, use "localhost"
DB_URL=jdbc:postgresql://postgres:5432/unigig
DB_USERNAME=postgres
DB_PASSWORD=change-me-local-db-password

# --- JWT Security (Must be at least 32 characters / 256 bits for HMAC-SHA256) ---
JWT_SECRET=replace-with-a-secure-256-bit-secret-key-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# --- CORS Allowed Origins (comma-separated list of frontend URLs) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://your-github-username.github.io
