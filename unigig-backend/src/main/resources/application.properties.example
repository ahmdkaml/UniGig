spring.application.name=unigig-backend
server.port=${PORT:8080}

# PostgreSQL (matches docker-compose.yml local defaults)
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/unigig}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:postgres}

# JPA & Flyway (Flyway owns all schema changes; Hibernate only validates)
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# JWT & CORS Settings (override via environment variables in staging/production)
app.jwt.secret=${JWT_SECRET:replace-with-a-256-bit-base64-secret-key-for-local-dev}
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:4200}
